    "serve": "vite",
    "serve:host": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e playwright.config.ts playwright.shots.config.ts",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p e2e",
